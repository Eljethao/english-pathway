# Copy to .env.local and fill in from Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: AI speaking feedback with Gemini (Google AI Studio → Get API key). Server-only: never prefix with NEXT_PUBLIC_.
# Free-tier model only, per project decision — do not switch to a Pro model. Models are tried in order.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview
