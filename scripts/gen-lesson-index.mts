// Regenerates src/content/lessons/index.ts from the lesson files that exist.
// Run: node scripts/gen-lesson-index.mts
import { existsSync, writeFileSync } from "node:fs";
import path from "node:path";
import { pathToFileURL } from "node:url";

const root = path.resolve(import.meta.dirname, "..");
const dir = path.join(root, "src/content/lessons");
const { LESSON_MANIFEST } = await import(pathToFileURL(path.join(dir, "manifest.ts")).href);

const present = (LESSON_MANIFEST as { slug: string; skill: string }[]).filter((m) =>
  existsSync(path.join(dir, m.skill, `${m.slug}.ts`)),
);
const ident = (slug: string) => slug.replace(/-([a-z0-9])/g, (_, c: string) => c.toUpperCase());

const out = `// Generated by scripts/gen-lesson-index.mts. Do not edit by hand.
import type { Lesson } from "@/lib/types";
${present.map((m) => `import ${ident(m.slug)} from "./${m.skill}/${m.slug}";`).join("\n")}

export const LESSONS: Lesson[] = [
${present.map((m) => `  ${ident(m.slug)},`).join("\n")}
];
`;
writeFileSync(path.join(dir, "index.ts"), out);
console.log(`Wrote index with ${present.length}/${LESSON_MANIFEST.length} lessons.`);
